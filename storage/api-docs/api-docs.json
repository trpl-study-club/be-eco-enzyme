{
    "openapi": "3.0.0",
    "info": {
        "title": "Pengabdian Dosen - Landing Page API",
        "description": "API publik untuk mengambil data konten landing page Program Pengabdian Dosen. Semua endpoint bersifat read-only (GET) dan tidak memerlukan autentikasi.",
        "contact": {
            "name": "Admin",
            "email": "admin@pengabdiandosen.id"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1 Server"
        }
    ],
    "paths": {
        "/contact": {
            "get": {
                "tags": [
                    "Contact"
                ],
                "summary": "Data Kontak",
                "description": "Menampilkan section kontak yang aktif beserta daftar item kontak (alamat, email, WhatsApp, dll). Hanya mengembalikan 1 section aktif.",
                "operationId": "27825138666a8e10318d78cf196867d2",
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/ContactSection"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/products": {
            "get": {
                "tags": [
                    "Product Section"
                ],
                "summary": "Daftar Produk aktif",
                "description": "Menampilkan semua produk dari product section yang berstatus aktif beserta gambar dan spesifikasinya, diurutkan berdasarkan order secara ascending.",
                "operationId": "b6cd28d879a52d15232a6da7a92c0d11",
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Product"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/testimonials": {
            "get": {
                "tags": [
                    "Testimonial"
                ],
                "summary": "Data Testimoni",
                "description": "Menampilkan section testimoni yang aktif beserta daftar statistik dan testimoni pelanggan. Hanya mengembalikan 1 section aktif.",
                "operationId": "c1e780205e01566f0dc6bd13e2a2b934",
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/TestimonialSection"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ProductSection": {
                "title": "Product Section",
                "description": "Konten section produk / katalog pada landing page",
                "properties": {
                    "id": {
                        "description": "OpenAPI Schema definitions for all API resources.\nSchemas are defined here to keep controllers clean.",
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Produk Unggulan Kami"
                    },
                    "description": {
                        "type": "string",
                        "example": "<p>Berikut produk-produk hasil program...</p>"
                    },
                    "whatsapp_number": {
                        "type": "string",
                        "example": "6281234567890",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "products": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Product"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Product": {
                "title": "Product",
                "description": "Detail produk dalam katalog",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Sabun Batang"
                    },
                    "description": {
                        "type": "string",
                        "example": "Lembut di kulit, wangi alami dari enzim buah."
                    },
                    "benefit": {
                        "type": "string",
                        "example": "Aman untuk kulit sensitif anak-anak.",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "example": "Sabun batang alami berbahan dasar eco-enzyme fermentasi buah.",
                        "nullable": true
                    },
                    "price": {
                        "type": "string",
                        "example": "Rp 15.000"
                    },
                    "order": {
                        "type": "integer",
                        "example": 1
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "url"
                        },
                        "example": [
                            "https://sanitasihijau.com/storage/products/sabun-batang-1.webp",
                            "https://sanitasihijau.com/storage/product-detail-images/sabun-batang-2.webp"
                        ]
                    },
                    "specs": {
                        "properties": {
                            "netto": {
                                "type": "string",
                                "example": "100 gr",
                                "nullable": true
                            },
                            "packaging": {
                                "type": "string",
                                "example": "Kertas Kraft Daur Ulang",
                                "nullable": true
                            },
                            "shape": {
                                "type": "string",
                                "example": "Batang Padat (Bunga, Hexagonal)",
                                "nullable": true
                            },
                            "suitability": {
                                "type": "string",
                                "example": "Semua Jenis Kulit & Balita",
                                "nullable": true
                            },
                            "stock": {
                                "type": "string",
                                "example": "Tersedia (Ready Stock)",
                                "nullable": true
                            },
                            "certification": {
                                "type": "string",
                                "example": "100% Organik & Biodegradable",
                                "nullable": true
                            },
                            "ingredients": {
                                "type": "string",
                                "example": "Minyak kelapa murni dan fermentasi eco-enzyme buah.",
                                "nullable": true
                            },
                            "usage": {
                                "type": "string",
                                "example": "Busakan dengan air, usapkan lembut ke seluruh tubuh, lalu bilas hingga bersih.",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ProductDetailImage": {
                "title": "Product Detail Image",
                "description": "Detail gambar / galeri foto produk (maksimal 5 foto per produk)",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "product_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "image_url": {
                        "type": "string",
                        "format": "url",
                        "example": "http://localhost:8000/storage/product-detail-images/sabun-detail-1.jpg"
                    },
                    "order": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "TestimonialSection": {
                "title": "Testimonial Section",
                "description": "Konten section testimoni pada landing page",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Apa Kata Mereka?"
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "statistics": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Statistic"
                        }
                    },
                    "testimonials": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Testimonial"
                        }
                    }
                },
                "type": "object"
            },
            "Statistic": {
                "title": "Statistic",
                "description": "Data statistik pada section testimoni",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "value": {
                        "type": "string",
                        "example": "500+"
                    },
                    "description": {
                        "type": "string",
                        "example": "Pelanggan Puas"
                    }
                },
                "type": "object"
            },
            "Testimonial": {
                "title": "Testimonial",
                "description": "Data testimoni pelanggan",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "quote": {
                        "type": "string",
                        "example": "Produknya sangat berkualitas dan ramah lingkungan!"
                    },
                    "name": {
                        "type": "string",
                        "example": "Budi Santoso"
                    },
                    "location": {
                        "type": "string",
                        "example": "Surabaya, Jawa Timur",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ContactSection": {
                "title": "Contact Section",
                "description": "Konten section kontak pada landing page",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Hubungi Kami"
                    },
                    "description": {
                        "type": "string",
                        "example": "Jangan ragu untuk menghubungi kami",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "location": {
                        "type": "string",
                        "example": "Jl. Contoh No. 123, Surabaya",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "example": "info@pengabdiandosen.id",
                        "nullable": true
                    },
                    "whatsapp": {
                        "type": "string",
                        "example": "6281234567890",
                        "nullable": true
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ContactItem"
                        }
                    },
                    "contacts": {
                        "description": "Alias dari items (data yang sama)",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ContactItem"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ContactItem": {
                "title": "Contact Item",
                "description": "Item kontak individu (alamat, email, telepon, dll)",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "whatsapp"
                    },
                    "label": {
                        "type": "string",
                        "example": "WhatsApp Kami"
                    },
                    "value": {
                        "type": "string",
                        "example": "6281234567890"
                    },
                    "icon_name": {
                        "type": "string",
                        "example": "phone",
                        "nullable": true
                    },
                    "icon_image": {
                        "type": "string",
                        "nullable": true
                    },
                    "icon_image_url": {
                        "type": "string",
                        "format": "url",
                        "nullable": true
                    },
                    "order": {
                        "type": "integer",
                        "example": 1
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Product Section",
            "description": "Endpoint untuk konten section produk / katalog"
        },
        {
            "name": "Testimonial",
            "description": "Endpoint untuk konten section testimoni"
        },
        {
            "name": "Contact",
            "description": "Endpoint untuk konten section kontak"
        }
    ]
}